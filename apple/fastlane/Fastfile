default_platform(:ios)

platform :ios do
  desc "Build and export BizXtreme IPA using Xcode"
  lane :build do
    build_app(
      scheme: ENV.fetch("SCHEME", "BizXtremeApple"),
      project: "apple/BizXtremeApple.xcodeproj",
      clean: true,
      output_directory: "build/ipa",
      archive_path: "build/archive/BizXtremeApple.xcarchive",
      skip_codesigning: ENV.fetch("SKIP_CODESIGNING", "true") == "true",
      export_method: ENV.fetch("EXPORT_METHOD", "development")
    )
  end
end
